@echo off
REM TA注意力机制对照实验批处理脚本
REM 依次执行三个实验：
REM 1. T=10，不禁止发放脉冲（对照实验）
REM 2. T=20，禁止发放脉冲
REM 3. T=20，不禁止发放脉冲（对照实验）

echo ================================================================================
echo TA注意力机制对照实验脚本
echo ================================================================================
echo.

REM 实验1: T=10 (不禁止发放脉冲)
echo ================================================================================
echo 开始实验1: T=10 (不禁止发放脉冲)
echo 描述: T=10，不禁止发放脉冲，作为对照实验
echo ================================================================================
echo.
python Att_SNN_CNN.py --attention TA --T 10 --dt 25
if %errorlevel% neq 0 (
    echo.
    echo 实验1失败！错误代码: %errorlevel%
    pause
    exit /b %errorlevel%
)
echo.
echo 实验1完成！
echo.
timeout /t 5 /nobreak >nul

REM 实验2: T=20 (禁止发放脉冲)
echo ================================================================================
echo 开始实验2: T=20 (禁止发放脉冲)
echo 描述: T=20，禁止发放脉冲，从20步中选择10步禁止发放脉冲
echo ================================================================================
echo.
python Att_SNN_CNN.py --attention TA --T 20 --dt 25 --disable_spike
if %errorlevel% neq 0 (
    echo.
    echo 实验2失败！错误代码: %errorlevel%
    pause
    exit /b %errorlevel%
)
echo.
echo 实验2完成！
echo.
timeout /t 5 /nobreak >nul

REM 实验3: T=20 (不禁止发放脉冲)
echo ================================================================================
echo 开始实验3: T=20 (不禁止发放脉冲)
echo 描述: T=20，不禁止发放脉冲，作为对照实验
echo ================================================================================
echo.
python Att_SNN_CNN.py --attention TA --T 20 --dt 25
if %errorlevel% neq 0 (
    echo.
    echo 实验3失败！错误代码: %errorlevel%
    pause
    exit /b %errorlevel%
)
echo.
echo 实验3完成！
echo.

echo ================================================================================
echo 所有实验执行完成！
echo ================================================================================
pause

